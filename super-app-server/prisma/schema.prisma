datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS HỆ THỐNG HỆN TẠI (GIỮ NGUYÊN)
// ══════════════════════════════════════════════════════════════════════════════
enum Role {
  USER
  DRIVER
  SELLER
  ADMIN
  MODERATOR
}

enum Currency {
  VND
}

enum WalletStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionType {
  TOP_UP
  WITHDRAW
  TRANSFER
  PAYMENT
  REFUND
  REWARD
  PENALTY
  RIDE_PAYMENT
  FOOD_PAYMENT
  SHOP_PAYMENT
  DELIVERY_PAYMENT
  SYSTEM_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS HỆ THỐNG MỚI (MỞ RỘNG CHO TOÀN V-LIFE)
// ══════════════════════════════════════════════════════════════════════════════
enum ServiceType {
  HOTEL_BOOKING
  HOMESTAY_BOOKING
  CAMPING_BOOKING
  CAR_RENTAL
  FOOD_ORDER
  RESTAURANT_RESERVATION
  RIDE_BOOKING
  TRAVEL_ACTIVITY
  TICKET_BOOKING
  GENERAL_SERVICE
}

enum PaymentProvider {
  VIETQR
  VNPAY
  MOMO
  ZALOPAY
  STRIPE
  VLIFE_WALLET
  CASH_ON_DELIVERY
}

enum PayoutProvider {
  BANK_TRANSFER_247
  VIETQR_PAYOUT
  INTERNAL_WALLET
  MANUAL_PAYOUT
}

enum PaymentStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_PAID
  PAYOUT_PROCESSING
  PAYOUT_ERROR
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS HỆ THỐNG HỆN TẠI (GIỮ NGUYÊN THÊM QUAN HỆ Bổ SUNG)
// ══════════════════════════════════════════════════════════════════════════════
model User {
  id                 String       @id @default(uuid())
  phone              String       @unique
  email              String?      @unique
  username           String?      @unique
  password           String
  fullName           String
  avatarUrl          String?
  bio                String?
  birthYear          Int?
  gender             String?
  hometown           String?
  role               Role         @default(USER)
  hashedRefreshToken String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  addresses          Address[]
  wallet             Wallet?
  bookings           Booking[]
  devices            UserDevice[]
  videos             Video[]
  videoLikes         VideoLike[]
  videoComments      VideoComment[]
  videoCommentLikes  VideoCommentLike[]
  videoSaves         VideoSave[]
  videoViews         VideoView[]
  videoShares        VideoShare[]
  videoReports       VideoReport[]
  followers          Follow[]           @relation("UserFollowers")
  following          Follow[]           @relation("UserFollowing")
  foodOrders         FoodOrder[]
}

model UserDevice {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  deviceName       String
  manufacturer     String?
  modelName        String?
  platform         String
  osVersion        String?
  ipAddress        String?
  status           String    @default("ACTIVE")
  refreshTokenHash String?
  lastLoginAt      DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  loggedOutAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  receiverName  String
  receiverPhone String
  province      String
  district      String
  ward          String
  detailAddress String
  note          String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Driver {
  id                 String   @id @default(uuid())
  phone              String   @unique
  password           String
  fullName           String
  avatarUrl          String?
  licensePlate       String
  vehicleType        String
  role               Role     @default(DRIVER)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime    @updatedAt
  foodOrders         FoodOrder[]
}

model Wallet {
  id             String       @id @default(uuid())
  userId         String       @unique
  walletNumber   String       @unique
  balance        Decimal      @default(0)
  pendingBalance Decimal      @default(0)
  rewardPoints   Int          @default(0)
  currency       Currency     @default(VND)
  status         WalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String            @id @default(uuid())
  walletId       String
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  type           TransactionType
  direction      TransactionDirection
  status         TransactionStatus @default(PENDING)
  currency       Currency          @default(VND)
  description    String?
  referenceId    String?
  referenceType  String?
  idempotencyKey String?           @unique
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: ĐỐI TÁC & DỊCH VỤ V-LIFE
// ══════════════════════════════════════════════════════════════════════════════
model Partner {
  id                String          @id @default(uuid())
  userId            String?         @unique
  businessName      String
  phone             String          @unique
  email             String?
  bankName          String
  bankCode          String
  bankAccountNo     String
  bankAccountHolder String
  commissionRate    Decimal         @default(0.25)
  isActive          Boolean         @default(true)
  balance           PartnerBalance?
  services          Service[]
  bookings          Booking[]
  payouts           Payout[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PartnerBalance {
  id               String   @id @default(uuid())
  partnerId        String   @unique
  partner          Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0)
  pendingBalance   Decimal  @default(0)
  totalRevenue     Decimal  @default(0)
  totalCommission  Decimal  @default(0)
  totalPaidOut     Decimal  @default(0)
  updatedAt        DateTime @updatedAt
}

model Service {
  id          String      @id @default(uuid())
  partnerId   String
  partner     Partner     @relation(fields: [partnerId], references: [id])
  type        ServiceType
  title       String
  description String?
  basePrice   Decimal
  isAvailable Boolean     @default(true)
  metadata    Json?
  bookings    Booking[]
  videos      Video[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([partnerId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: BOOKING, PAYMENT & IDEMPOTENCY ENGINE
// ══════════════════════════════════════════════════════════════════════════════
model Booking {
  id               String        @id @default(uuid())
  bookingCode      String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  partnerId        String
  partner          Partner       @relation(fields: [partnerId], references: [id])
  serviceId        String
  service          Service       @relation(fields: [serviceId], references: [id])
  status           BookingStatus @default(PENDING_PAYMENT)
  
  grossAmount      Decimal
  commissionRate   Decimal       @default(0.25)
  commissionAmount Decimal
  partnerAmount    Decimal

  startDate        DateTime
  endDate          DateTime
  expiresAt        DateTime

  payments         Payment[]
  commission       Commission?
  payout           Payout?
  refunds          Refund[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([bookingCode])
  @@index([expiresAt])
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String          @unique
  bookingId             String
  booking               Booking         @relation(fields: [bookingId], references: [id])
  amount                Decimal
  currency              Currency        @default(VND)
  provider              PaymentProvider @default(VIETQR)
  status                PaymentStatus   @default(PENDING)
  providerTransactionId String?
  idempotencyKey        String          @unique
  events                PaymentEvent[]
  refunds               Refund[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([orderId])
}

model PaymentEvent {
  id                    String   @id @default(uuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType             String
  providerTransactionId String?
  payload               Json
  createdAt             DateTime @default(now())

  @@index([paymentId])
  @@index([providerTransactionId])
}

model Commission {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount      Decimal
  commissionRate   Decimal
  commissionAmount Decimal
  partnerAmount    Decimal
  createdAt        DateTime @default(now())
}

model Payout {
  id             String         @id @default(uuid())
  partnerId      String
  partner        Partner        @relation(fields: [partnerId], references: [id])
  bookingId      String         @unique
  booking        Booking        @relation(fields: [bookingId], references: [id])
  amount         Decimal
  provider       PayoutProvider @default(BANK_TRANSFER_247)
  status         PayoutStatus   @default(PENDING)
  retryCount     Int            @default(0)
  failureReason  String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([idempotencyKey])
}

model Refund {
  id             String       @id @default(uuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id])
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id])
  amount         Decimal
  reason         String?
  status         RefundStatus @default(PENDING)
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([bookingId])
  @@index([paymentId])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: HỆ THỐNG CẤU HÌNH & THÔNG BÁO TẬP TRUNG
// ══════════════════════════════════════════════════════════════════════════════
model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id            String   @id @default(uuid())
  recipientId   String
  recipientType String
  title         String
  body          String
  data          Json?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientId])
  @@index([recipientType])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: MODULE VIDEO (V-LIFE SHORT VIDEOS)
// ══════════════════════════════════════════════════════════════════════════════

enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  BLOCKED
  DELETED
}

model Video {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  caption       String?
  musicTitle    String?           @default("Âm thanh gốc")
  location      String?
  status        VideoStatus       @default(PUBLISHED)
  
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  viewsCount    Int               @default(0)
  likesCount    Int               @default(0)
  commentsCount Int               @default(0)
  sharesCount   Int               @default(0)
  savesCount    Int               @default(0)

  media         VideoMedia[]
  processing    VideoProcessing?
  likes         VideoLike[]
  comments      VideoComment[]
  saves         VideoSave[]
  views         VideoView[]
  shares        VideoShare[]
  hashtags      VideoHashtag[]
  reports       VideoReport[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([serviceId])
}

model VideoMedia {
  id              String   @id @default(uuid())
  videoId         String
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  url             String
  thumbnailUrl    String?
  duration        Float?
  width           Int?
  height          Int?
  sizeBytes       BigInt?
  mimeType        String?  @default("video/mp4")
  storageProvider String   @default("LOCAL")
  isOriginal      Boolean  @default(true)
  
  createdAt       DateTime @default(now())

  @@index([videoId])
}

model VideoProcessing {
  id           String   @id @default(uuid())
  videoId      String   @unique
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  status       String   @default("COMPLETED")
  progress     Int      @default(100)
  errorMessage String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VideoLike {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
}

model VideoComment {
  id         String             @id @default(uuid())
  videoId    String
  video      Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  parentId   String?
  parent     VideoComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    VideoComment[]     @relation("CommentReplies")
  
  content    String
  likesCount Int                @default(0)
  likes      VideoCommentLike[]
  
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([videoId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model VideoCommentLike {
  id        String       @id @default(uuid())
  commentId String
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, commentId])
}

model VideoSave {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId])
}

model VideoView {
  id            String   @id @default(uuid())
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress     String?
  watchDuration Float?
  createdAt     DateTime @default(now())

  @@index([videoId, createdAt])
  @@index([userId])
}

model VideoShare {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform  String?
  createdAt DateTime @default(now())

  @@index([videoId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Hashtag {
  id         String         @id @default(uuid())
  name       String         @unique
  usageCount Int            @default(0)
  videos     VideoHashtag[]
  createdAt  DateTime       @default(now())

  @@index([name])
}

model VideoHashtag {
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtagId])
}

model VideoReport {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  details   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([status])
}

// ============================================================================
// PHÂN HỆ ĐẶT ĐỒ ĂN (FOOD DELIVERY ECOSYSTEM)
// ============================================================================

enum FoodOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  FINDING_DRIVER
  DRIVER_ACCEPTED
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum FoodPaymentMethod {
  COD
  WALLET
  VIETQR
}

model Restaurant {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  avatar       String?
  coverImage   String?
  address      String
  latitude     Float
  longitude    Float
  rating       Float          @default(5.0)
  totalReviews Int            @default(0)
  openingHours String         @default("07:00 - 22:00")
  isActive     Boolean        @default(true)
  categories   MenuCategory[]
  items        MenuItem[]
  orders       FoodOrder[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([latitude, longitude])
  @@index([isActive])
}

model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id            String            @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      MenuCategory?     @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Float
  originalPrice Float?
  image         String?
  calories      String?
  isAvailable   Boolean           @default(true)
  optionGroups  ItemOptionGroup[]
  orderItems    FoodOrderItem[]
  createdAt     DateTime          @default(now())

  @@index([restaurantId])
  @@index([categoryId])
}

model ItemOptionGroup {
  id         String       @id @default(uuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean      @default(false)
  maxSelect  Int          @default(1)
  options    ItemOption[]

  @@index([menuItemId])
}

model ItemOption {
  id      String          @id @default(uuid())
  groupId String
  group   ItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  price   Float           @default(0)

  @@index([groupId])
}

model FoodOrder {
  id              String            @id @default(uuid())
  orderCode       String            @unique
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  driverId        String?
  driver          Driver?           @relation(fields: [driverId], references: [id])
  status          FoodOrderStatus   @default(PENDING)
  paymentMethod   FoodPaymentMethod @default(COD)
  paymentStatus   String            @default("UNPAID")
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  distanceKm      Float             @default(0)
  subtotal        Float
  shippingFee     Float
  discountAmount  Float             @default(0)
  totalAmount     Float
  noteForMerchant String?
  noteForDriver   String?
  items           FoodOrderItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([driverId])
  @@index([status])
}

model FoodOrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  name        String
  price       Float
  quantity    Int
  notes       String?
  optionsJson Json?

  @@index([orderId])
  @@index([menuItemId])
}

