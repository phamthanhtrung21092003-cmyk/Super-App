datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS HỆ THỐNG HỆN TẠI (GIỮ NGUYÊN)
// ══════════════════════════════════════════════════════════════════════════════
enum Role {
  USER
  DRIVER
  SELLER
  ADMIN
  MODERATOR
}

enum Currency {
  VND
}

enum WalletStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionType {
  TOP_UP
  WITHDRAW
  TRANSFER
  PAYMENT
  REFUND
  REWARD
  PENALTY
  RIDE_PAYMENT
  FOOD_PAYMENT
  SHOP_PAYMENT
  DELIVERY_PAYMENT
  SYSTEM_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS HỆ THỐNG MỚI (MỞ RỘNG CHO TOÀN V-LIFE)
// ══════════════════════════════════════════════════════════════════════════════
enum ServiceType {
  HOTEL_BOOKING
  HOMESTAY_BOOKING
  CAMPING_BOOKING
  CAR_RENTAL
  FOOD_ORDER
  RESTAURANT_RESERVATION
  RIDE_BOOKING
  TRAVEL_ACTIVITY
  TICKET_BOOKING
  GENERAL_SERVICE
}

enum PaymentProvider {
  VIETQR
  VNPAY
  MOMO
  ZALOPAY
  STRIPE
  VLIFE_WALLET
  CASH_ON_DELIVERY
}

enum PayoutProvider {
  BANK_TRANSFER_247
  VIETQR_PAYOUT
  INTERNAL_WALLET
  MANUAL_PAYOUT
}

enum PaymentStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_PAID
  PAYOUT_PROCESSING
  PAYOUT_ERROR
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS HỆ THỐNG HỆN TẠI (GIỮ NGUYÊN THÊM QUAN HỆ Bổ SUNG)
// ══════════════════════════════════════════════════════════════════════════════
model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  email              String?            @unique
  username           String?            @unique
  password           String
  fullName           String
  avatarUrl          String?
  bio                String?
  birthYear          Int?
  gender             String?
  hometown           String?
  role               Role               @default(USER)
  hashedRefreshToken String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  addresses          Address[]
  wallet             Wallet?
  bookings           Booking[]
  devices            UserDevice[]
  videos             Video[]
  videoLikes         VideoLike[]
  videoComments      VideoComment[]
  videoCommentLikes  VideoCommentLike[]
  videoSaves         VideoSave[]
  videoViews         VideoView[]
  videoShares        VideoShare[]
  videoReports       VideoReport[]
  followers          Follow[]           @relation("UserFollowers")
  following          Follow[]           @relation("UserFollowing")
  foodOrders         FoodOrder[]
  rideBookings       RideBooking[]
  movieOrders        MovieOrder[]
  seatHolds          SeatHold[]
  voucherUsages      VoucherUsage[]
  managedRestaurants Restaurant[]       @relation("RestaurantOwner")
  foodAuditLogs      FoodAuditLog[]
  restaurantReviews  RestaurantReview[]
  itemReviews        ItemReview[]
  driverReviews      DriverReview[]
  foodVoucherUsages  FoodVoucherUsage[]
}

model UserDevice {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  deviceName       String
  manufacturer     String?
  modelName        String?
  platform         String
  osVersion        String?
  ipAddress        String?
  status           String    @default("ACTIVE")
  refreshTokenHash String?
  lastLoginAt      DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  loggedOutAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
}

model DevicePushToken {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  token      String    @unique
  platform   String    @default("android") // android | ios | web
  appRole    String    @default("CUSTOMER") // CUSTOMER | MERCHANT | DRIVER
  isActive   Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, deviceId, appRole])
  @@index([userId])
  @@index([token])
  @@index([appRole])
  @@index([isActive])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  receiverName  String
  receiverPhone String
  province      String
  district      String
  ward          String
  detailAddress String
  note          String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Driver {
  id                 String              @id @default(uuid())
  phone              String              @unique
  password           String
  fullName           String
  avatarUrl          String?
  licensePlate       String
  vehicleType        String
  role               Role                @default(DRIVER)
  hashedRefreshToken String?
  isOnline           Boolean             @default(false)
  currentLat         Float?
  currentLng         Float?
  heading            Float?
  speed              Float?              @default(0)
  walletBalance      Decimal             @default(0)
  creditBalance      Decimal             @default(250000)
  cashBalance        Decimal             @default(1485000)
  dailyEarnings      Decimal             @default(0)
  rating             Float               @default(5.0)
  totalTrips         Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  foodOrders         FoodOrder[]
  rideBookings       RideBooking[]
  transactions       DriverTransaction[]
  settings           DriverSettings?
  reviews            DriverReview[]
}

model DriverTransaction {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId        String?
  tripCode      String?
  title         String
  amount        Decimal
  balanceAfter  Decimal
  type          String
  walletType    String   @default("CREDIT")
  note          String?
  customerName  String?
  pickup        String?
  dropoff       String?
  distanceKm    Float?
  paymentMethod String?
  createdAt     DateTime @default(now())

  @@index([driverId])
  @@index([createdAt])
  @@index([type])
}

model DriverSettings {
  id              String   @id @default(uuid())
  driverId        String   @unique
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  autoAccept      Boolean  @default(false)
  dispatchRadius  Int      @default(5)
  enableRide      Boolean  @default(true)
  enableDelivery  Boolean  @default(true)
  enableFood      Boolean  @default(true)
  homeAddress     String?
  homeLat         Float?
  homeLng         Float?
  highVolumeAlert Boolean  @default(true)
  hapticFeedback  Boolean  @default(true)
  voiceGuidance   Boolean  @default(true)
  defaultMapApp   String   @default("GOOGLE_MAPS")
  autoOpenMap     Boolean  @default(false)
  avoidTolls      Boolean  @default(false)
  keepAwakeMode   String   @default("ONLINE_ONLY")
  themeMode       String   @default("SYSTEM")
  sosPhone1       String?  @default("113")
  sosPhone2       String?  @default("0988123456")
  updatedAt       DateTime @updatedAt
}

model Wallet {
  id             String       @id @default(uuid())
  userId         String       @unique
  walletNumber   String       @unique
  balance        Decimal      @default(0)
  pendingBalance Decimal      @default(0)
  rewardPoints   Int          @default(0)
  currency       Currency     @default(VND)
  status         WalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String               @id @default(uuid())
  walletId       String
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  type           TransactionType
  direction      TransactionDirection
  status         TransactionStatus    @default(PENDING)
  currency       Currency             @default(VND)
  description    String?
  referenceId    String?
  referenceType  String?
  idempotencyKey String?              @unique
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: ĐỐI TÁC & DỊCH VỤ V-LIFE
// ══════════════════════════════════════════════════════════════════════════════
model Partner {
  id                String          @id @default(uuid())
  userId            String?         @unique
  businessName      String
  phone             String          @unique
  email             String?
  bankName          String
  bankCode          String
  bankAccountNo     String
  bankAccountHolder String
  commissionRate    Decimal         @default(0.25)
  isActive          Boolean         @default(true)
  balance           PartnerBalance?
  services          Service[]
  bookings          Booking[]
  payouts           Payout[]
  cinemas           Cinema[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PartnerBalance {
  id               String   @id @default(uuid())
  partnerId        String   @unique
  partner          Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0)
  pendingBalance   Decimal  @default(0)
  totalRevenue     Decimal  @default(0)
  totalCommission  Decimal  @default(0)
  totalPaidOut     Decimal  @default(0)
  updatedAt        DateTime @updatedAt
}

model Service {
  id          String      @id @default(uuid())
  partnerId   String
  partner     Partner     @relation(fields: [partnerId], references: [id])
  type        ServiceType
  title       String
  description String?
  basePrice   Decimal
  isAvailable Boolean     @default(true)
  metadata    Json?
  bookings    Booking[]
  videos      Video[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([partnerId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: BOOKING, PAYMENT & IDEMPOTENCY ENGINE
// ══════════════════════════════════════════════════════════════════════════════
model Booking {
  id          String        @id @default(uuid())
  bookingCode String        @unique
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  partnerId   String
  partner     Partner       @relation(fields: [partnerId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  status      BookingStatus @default(PENDING_PAYMENT)

  grossAmount      Decimal
  commissionRate   Decimal @default(0.25)
  commissionAmount Decimal
  partnerAmount    Decimal

  startDate DateTime
  endDate   DateTime
  expiresAt DateTime

  payments   Payment[]
  commission Commission?
  payout     Payout?
  refunds    Refund[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([bookingCode])
  @@index([expiresAt])
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String          @unique
  bookingId             String?
  booking               Booking?        @relation(fields: [bookingId], references: [id])
  movieOrderId          String?
  movieOrder            MovieOrder?     @relation(fields: [movieOrderId], references: [id])
  amount                Decimal
  currency              Currency        @default(VND)
  provider              PaymentProvider @default(VIETQR)
  status                PaymentStatus   @default(PENDING)
  providerTransactionId String?
  idempotencyKey        String          @unique
  events                PaymentEvent[]
  refunds               Refund[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([bookingId])
  @@index([movieOrderId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([orderId])
}

model PaymentEvent {
  id                    String   @id @default(uuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType             String
  providerTransactionId String?
  payload               Json
  createdAt             DateTime @default(now())

  @@index([paymentId])
  @@index([providerTransactionId])
}

model Commission {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount      Decimal
  commissionRate   Decimal
  commissionAmount Decimal
  partnerAmount    Decimal
  createdAt        DateTime @default(now())
}

model Payout {
  id             String         @id @default(uuid())
  partnerId      String
  partner        Partner        @relation(fields: [partnerId], references: [id])
  bookingId      String         @unique
  booking        Booking        @relation(fields: [bookingId], references: [id])
  amount         Decimal
  provider       PayoutProvider @default(BANK_TRANSFER_247)
  status         PayoutStatus   @default(PENDING)
  retryCount     Int            @default(0)
  failureReason  String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([idempotencyKey])
}

model Refund {
  id             String       @id @default(uuid())
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  movieOrderId   String?
  movieOrder     MovieOrder?  @relation(fields: [movieOrderId], references: [id])
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id])
  amount         Decimal
  reason         String?
  status         RefundStatus @default(PENDING)
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([bookingId])
  @@index([movieOrderId])
  @@index([paymentId])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: HỆ THỐNG CẤU HÌNH & THÔNG BÁO TẬP TRUNG
// ══════════════════════════════════════════════════════════════════════════════
model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id            String   @id @default(uuid())
  recipientId   String
  recipientType String
  title         String
  body          String
  data          Json?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientId])
  @@index([recipientType])
}

// ══════════════════════════════════════════════════════════════════════════════
// MODELS BỔ SUNG: MODULE VIDEO (V-LIFE SHORT VIDEOS)
// ══════════════════════════════════════════════════════════════════════════════

enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  BLOCKED
  DELETED
}

model Video {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption    String?
  musicTitle String?     @default("Âm thanh gốc")
  location   String?
  status     VideoStatus @default(PUBLISHED)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  viewsCount    Int @default(0)
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)
  savesCount    Int @default(0)

  media      VideoMedia[]
  processing VideoProcessing?
  likes      VideoLike[]
  comments   VideoComment[]
  saves      VideoSave[]
  views      VideoView[]
  shares     VideoShare[]
  hashtags   VideoHashtag[]
  reports    VideoReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([serviceId])
}

model VideoMedia {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  url             String
  thumbnailUrl    String?
  duration        Float?
  width           Int?
  height          Int?
  sizeBytes       BigInt?
  mimeType        String? @default("video/mp4")
  storageProvider String  @default("LOCAL")
  isOriginal      Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([videoId])
}

model VideoProcessing {
  id      String @id @default(uuid())
  videoId String @unique
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  status       String  @default("COMPLETED")
  progress     Int     @default(100)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoLike {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
}

model VideoComment {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  VideoComment[] @relation("CommentReplies")

  content    String
  likesCount Int                @default(0)
  likes      VideoCommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model VideoCommentLike {
  id        String       @id @default(uuid())
  commentId String
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, commentId])
}

model VideoSave {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId])
}

model VideoView {
  id            String   @id @default(uuid())
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress     String?
  watchDuration Float?
  createdAt     DateTime @default(now())

  @@index([videoId, createdAt])
  @@index([userId])
}

model VideoShare {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform  String?
  createdAt DateTime @default(now())

  @@index([videoId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Hashtag {
  id         String         @id @default(uuid())
  name       String         @unique
  usageCount Int            @default(0)
  videos     VideoHashtag[]
  createdAt  DateTime       @default(now())

  @@index([name])
}

model VideoHashtag {
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtagId])
}

model VideoReport {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  details   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([status])
}

// ============================================================================
// PHÂN HỆ ĐẶT ĐỒ ĂN (FOOD DELIVERY ECOSYSTEM)
// ============================================================================

enum FoodOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  FINDING_DRIVER
  DRIVER_ACCEPTED
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum FoodPaymentMethod {
  COD
  WALLET
  VIETQR
}

model Restaurant {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  avatar            String?
  coverImage        String?
  address           String
  latitude          Float
  longitude         Float
  rating            Float          @default(5.0)
  totalReviews      Int            @default(0)
  openingHours      String         @default("07:00 - 22:00")
  isActive          Boolean        @default(true)
  isOpen            Boolean        @default(true)
  autoAcceptOrder   Boolean        @default(false)
  phoneNumber       String?

  ownerId           String?
  owner             User?          @relation("RestaurantOwner", fields: [ownerId], references: [id])

  // Tái sử dụng thông tin ngân hàng cho quyết toán tài chính
  bankName          String?
  bankCode          String?
  bankAccountNo     String?
  bankAccountHolder String?

  categories        MenuCategory[]
  items             MenuItem[]
  orders            FoodOrder[]
  auditLogs         FoodAuditLog[]
  reviews           RestaurantReview[]
  vouchers          FoodVoucher[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([latitude, longitude])
  @@index([isActive])
  @@index([isOpen])
  @@index([ownerId])
  @@index([name])
  @@index([rating])
}

model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id            String            @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      MenuCategory?     @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Float
  originalPrice Float?
  image         String?
  calories      String?
  isAvailable   Boolean           @default(true)
  rating        Float             @default(5.0)
  totalReviews  Int               @default(0)
  optionGroups  ItemOptionGroup[]
  orderItems    FoodOrderItem[]
  reviews       ItemReview[]
  createdAt     DateTime          @default(now())

  @@index([restaurantId])
  @@index([categoryId])
  @@index([name])
  @@index([price])
  @@index([isAvailable])
  @@index([rating])
}

model ItemOptionGroup {
  id         String       @id @default(uuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean      @default(false)
  maxSelect  Int          @default(1)
  options    ItemOption[]

  @@index([menuItemId])
}

model ItemOption {
  id      String          @id @default(uuid())
  groupId String
  group   ItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  price   Float           @default(0)

  @@index([groupId])
}

model FoodOrder {
  id                 String            @id @default(uuid())
  orderCode          String            @unique
  idempotencyKey     String?           @unique
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  restaurantId       String
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id])
  driverId           String?
  driver             Driver?           @relation(fields: [driverId], references: [id])
  status             FoodOrderStatus   @default(PENDING)
  paymentMethod      FoodPaymentMethod @default(COD)
  paymentStatus      String            @default("UNPAID")
  deliveryAddress    String
  deliveryLat        Float
  deliveryLng        Float
  distanceKm         Float             @default(0)
  subtotal           Float
  shippingFee        Float
  discountAmount     Float             @default(0)
  totalAmount        Float
  
  // Hạch toán tài chính 3 bên V-Life Food (90% - 110% - 20%)
  baseStorePrice     Float             @default(0)
  merchantEarning    Float             @default(0)
  appGrossProfit     Float             @default(0)
  appNetProfit       Float             @default(0)

  // Thông tin thời gian các mốc trạng thái
  confirmedAt        DateTime?
  preparingAt        DateTime?
  readyAt            DateTime?
  pickedUpAt         DateTime?
  completedAt        DateTime?

  // Thông tin hủy đơn / từ chối
  cancelledBy        String?
  cancellationReason String?
  rejectedReason     String?
  cancelledAt        DateTime?

  noteForMerchant    String?
  noteForDriver      String?
  items              FoodOrderItem[]
  auditLogs          FoodAuditLog[]
  restaurantReview   RestaurantReview?
  driverReview       DriverReview?
  itemReviews        ItemReview[]
  voucherId          String?
  voucher            FoodVoucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode        String?
  voucherName        String?
  discountType       String?
  discountValue      Float?
  voucherUsage       FoodVoucherUsage?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([driverId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([voucherId])
  @@index([voucherCode])
}

model FoodOrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  name        String
  price       Float     // Giá niêm yết snapshot tại thời điểm tạo đơn
  quantity    Int
  totalPrice  Float     @default(0) // Thành tiền món = price * quantity (+ options)
  notes       String?
  optionsJson Json?

  @@index([orderId])
  @@index([menuItemId])
}

model FoodAuditLog {
  id           String      @id @default(uuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  orderId      String?
  order        FoodOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  action       String      // e.g. "CONFIRM_ORDER", "REJECT_ORDER", "MARK_READY", "TOGGLE_STOCK", "TOGGLE_OPEN", "CREATE_ITEM", "UPDATE_ITEM", "AUTO_CONFIRM_ORDER"
  targetType   String      // e.g. "ORDER", "MENU_ITEM", "RESTAURANT"
  targetId     String?     // orderId, menuItemId, restaurantId
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([restaurantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RestaurantReview {
  id           String     @id @default(uuid())
  orderId      String     @unique
  order        FoodOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating       Int        // 1 to 5
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

model ItemReview {
  id         String    @id @default(uuid())
  orderId    String
  order      FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rating     Int       // 1 to 5
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orderId, menuItemId])
  @@index([menuItemId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

model DriverReview {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rating    Int       // 1 to 5
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([driverId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

enum FoodVoucherType {
  PERCENT
  FIXED
  FREESHIP
}

model FoodVoucher {
  id              String            @id @default(uuid())
  code            String            @unique
  name            String
  description     String?
  type            FoodVoucherType   @default(PERCENT)
  value           Float
  maxDiscount     Float?
  minOrderValue   Float             @default(0)
  maxUsage        Int               @default(100)
  usedCount       Int               @default(0)
  maxUsagePerUser Int               @default(1)
  startAt         DateTime          @default(now())
  endAt           DateTime
  isActive        Boolean           @default(true)

  restaurantId    String?
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  usages          FoodVoucherUsage[]
  orders          FoodOrder[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([code])
  @@index([restaurantId])
  @@index([isActive])
  @@index([startAt, endAt])
}

model FoodVoucherUsage {
  id             String      @id @default(uuid())
  voucherId      String
  voucher        FoodVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String      @unique
  order          FoodOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Float
  createdAt      DateTime    @default(now())

  @@index([voucherId, userId])
  @@index([userId])
  @@index([orderId])
}

model RideBooking {
  id             String   @id @default(uuid())
  bookingCode    String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  driverId       String?
  driver         Driver?  @relation(fields: [driverId], references: [id])
  serviceType    String   @default("RIDE")
  vehicleType    String   @default("ev")
  status         String   @default("SEARCHING")
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  distanceKm     Float
  durationMin    Int      @default(15)
  fareAmount     Float
  tipAmount      Float    @default(0)
  discountAmount Float    @default(0)
  finalAmount    Float
  paymentMethod  String   @default("CASH")
  paymentStatus  String   @default("PENDING")
  customerName   String
  customerPhone  String
  driverRating   Int?
  driverReview   String?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([driverId])
  @@index([status])
}

// ============================================================================
// PHÂN HỆ ĐẶT VÉ XEM PHIM (MOVIE TICKET DOMAIN — PHASE 1 FOUNDATION)
// ============================================================================

enum CinemaBrand {
  CGV
  LOTTE
  GALAXY
  BETA
  BHD
  CINESTAR
  OTHER
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum ShowtimeSeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum SeatHoldStatus {
  HELD
  RELEASED
  EXPIRED
  CONVERTED
}

enum MovieOrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum MovieOrderItemType {
  SEAT
  COMBO
}

enum MovieBookingStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  BOOKING_CONFIRMING
  BOOKING_CONFIRMED
  TICKET_ISSUED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  EXPIRED
}

enum MovieTicketType {
  PRINT_AT_COUNTER
}

enum MovieTicketStatus {
  ISSUED
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum VoucherDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model CinemaIntegration {
  id             String      @id @default(uuid())
  brand          CinemaBrand @unique
  adapterKey     String      @unique
  providerName   String
  baseUrl        String?
  apiVersion     String      @default("v1")
  authType       String      @default("API_KEY")
  timeoutMs      Int         @default(10000)
  retryLimit     Int         @default(3)
  holdTtlSeconds Int         @default(600)
  supportsCancel Boolean     @default(false)
  isActive       Boolean     @default(true)
  config         Json?
  cinemas        Cinema[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([brand])
  @@index([isActive])
}

model Cinema {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  brand         CinemaBrand
  integrationId String?
  integration   CinemaIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  partnerId     String?
  partner       Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  city          String
  area          String?
  address       String
  phone         String?
  openingHours  String?            @default("08:00 - 23:45")
  latitude      Float?
  longitude     Float?
  facilities    Json?
  isActive      Boolean            @default(true)
  metadata      Json?
  auditoriums   Auditorium[]
  showtimes     Showtime[]
  combos        Combo[]
  movieOrders   MovieOrder[]
  movieBookings MovieBooking[]
  movieTickets  MovieTicket[]
  vouchers      Voucher[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([brand])
  @@index([city])
  @@index([integrationId])
  @@index([partnerId])
  @@index([isActive])
}

model Auditorium {
  id         String     @id @default(uuid())
  cinemaId   String
  cinema     Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  code       String
  name       String
  totalRows  Int        @default(6)
  totalCols  Int        @default(8)
  capacity   Int        @default(48)
  screenType String     @default("2D")
  isActive   Boolean    @default(true)
  metadata   Json?
  seats      Seat[]
  showtimes  Showtime[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([cinemaId, code])
  @@index([cinemaId])
  @@index([isActive])
}

model Seat {
  id            String           @id @default(uuid())
  auditoriumId  String
  auditorium    Auditorium       @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  seatCode      String
  rowLabel      String
  seatNumber    Int
  type          SeatType         @default(STANDARD)
  seatSpan      Int              @default(1)
  priceModifier Decimal          @default(0)
  isActive      Boolean          @default(true)
  showtimeSeats ShowtimeSeat[]
  seatHolds     SeatHold[]
  orderItems    MovieOrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([auditoriumId, seatCode])
  @@unique([auditoriumId, rowLabel, seatNumber])
  @@index([auditoriumId])
  @@index([type])
}

model Movie {
  id            String        @id @default(uuid())
  slug          String        @unique
  externalCode  String?       @unique
  title         String
  originalTitle String?
  description   String?
  posterUrl     String
  bannerUrl     String?
  trailerUrl    String?
  ageRating     String        @default("T13")
  durationMin   Int           @default(110)
  genres        String
  director      String?
  cast          String?
  language      String?       @default("Tiếng Việt")
  releaseDate   DateTime?
  rating        Float         @default(4.8)
  isShowing     Boolean       @default(true)
  isActive      Boolean       @default(true)
  metadata      Json?
  showtimes     Showtime[]
  movieOrders   MovieOrder[]
  movieTickets  MovieTicket[]
  vouchers      Voucher[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isShowing, isActive])
  @@index([ageRating])
}

model Showtime {
  id              String         @id @default(uuid())
  externalCode    String?        @unique
  movieId         String
  movie           Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  cinemaId        String
  cinema          Cinema         @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  auditoriumId    String
  auditorium      Auditorium     @relation(fields: [auditoriumId], references: [id], onDelete: Restrict)
  screeningFormat String         @default("2D Phụ Đề Việt")
  startTime       DateTime
  endTime         DateTime
  basePrice       Decimal
  vipPrice        Decimal
  couplePrice     Decimal
  serviceFee      Decimal        @default(5000)
  isActive        Boolean        @default(true)
  metadata        Json?
  showtimeSeats   ShowtimeSeat[]
  seatHolds       SeatHold[]
  movieOrders     MovieOrder[]
  movieBookings   MovieBooking[]
  movieTickets    MovieTicket[]
  vouchers        Voucher[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([auditoriumId, startTime])
  @@index([movieId])
  @@index([cinemaId])
  @@index([auditoriumId])
  @@index([startTime])
  @@index([cinemaId, movieId, startTime])
}

model ShowtimeSeat {
  id             String             @id @default(uuid())
  showtimeId     String
  showtime       Showtime           @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId         String
  seat           Seat               @relation(fields: [seatId], references: [id], onDelete: Cascade)
  seatCode       String
  seatType       SeatType
  price          Decimal
  status         ShowtimeSeatStatus @default(AVAILABLE)
  heldByUserId   String?
  activeHoldId   String?            @unique
  holdExpiresAt  DateTime?
  movieBookingId String?
  version        Int                @default(1)
  orderItems     MovieOrderItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([showtimeId, seatId])
  @@index([showtimeId, status])
  @@index([heldByUserId])
  @@index([holdExpiresAt])
}

model SeatHold {
  id           String         @id @default(uuid())
  holdCode     String         @unique
  showtimeId   String
  showtime     Showtime       @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId       String
  seat         Seat           @relation(fields: [seatId], references: [id], onDelete: Restrict)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieOrderId String?
  movieOrder   MovieOrder?    @relation(fields: [movieOrderId], references: [id], onDelete: SetNull)
  status       SeatHoldStatus @default(HELD)
  expiresAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([showtimeId, seatId, status])
  @@index([userId, status])
  @@index([movieOrderId])
  @@index([status, expiresAt])
}

model Combo {
  id            String           @id @default(uuid())
  code          String           @unique
  cinemaId      String?
  cinema        Cinema?          @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  brand         CinemaBrand?
  name          String
  description   String?
  imageUrl      String?
  price         Decimal
  originalPrice Decimal?
  savingsText   String?
  stockQuantity Int?
  isActive      Boolean          @default(true)
  metadata      Json?
  orderItems    MovieOrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([cinemaId])
  @@index([brand])
  @@index([isActive])
}

model Voucher {
  id                String              @id @default(uuid())
  code              String              @unique
  title             String
  description       String?
  discountType      VoucherDiscountType @default(FIXED_AMOUNT)
  discountValue     Decimal
  maxDiscountAmount Decimal?
  minOrderAmount    Decimal             @default(0)
  usageLimit        Int                 @default(100)
  usedCount         Int                 @default(0)
  perUserLimit      Int                 @default(1)
  validFrom         DateTime
  validUntil        DateTime
  cinemaBrand       CinemaBrand?
  cinemaId          String?
  cinema            Cinema?             @relation(fields: [cinemaId], references: [id], onDelete: SetNull)
  movieId           String?
  movie             Movie?              @relation(fields: [movieId], references: [id], onDelete: SetNull)
  showtimeId        String?
  showtime          Showtime?           @relation(fields: [showtimeId], references: [id], onDelete: SetNull)
  status            VoucherStatus       @default(ACTIVE)
  metadata          Json?
  orders            MovieOrder[]
  usages            VoucherUsage[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([code, status])
  @@index([validFrom, validUntil])
  @@index([cinemaBrand])
  @@index([cinemaId])
  @@index([movieId])
}

model VoucherUsage {
  id             String     @id @default(uuid())
  voucherId      String
  voucher        Voucher    @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieOrderId   String     @unique
  movieOrder     MovieOrder @relation(fields: [movieOrderId], references: [id], onDelete: Cascade)
  discountAmount Decimal
  createdAt      DateTime   @default(now())

  @@index([voucherId, userId])
  @@index([userId])
}

model MovieOrder {
  id               String           @id @default(uuid())
  orderCode        String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  movieId          String
  movie            Movie            @relation(fields: [movieId], references: [id], onDelete: Restrict)
  cinemaId         String
  cinema           Cinema           @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  showtimeId       String
  showtime         Showtime         @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  voucherId        String?
  voucher          Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode      String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  seatsSubtotal    Decimal
  combosSubtotal   Decimal          @default(0)
  serviceFee       Decimal          @default(5000)
  discountAmount   Decimal          @default(0)
  totalAmount      Decimal
  currency         Currency         @default(VND)
  status           MovieOrderStatus @default(PENDING)
  paymentReference String?
  bookingReference String?
  idempotencyKey   String           @unique
  expiresAt        DateTime
  metadata         Json?
  items            MovieOrderItem[]
  seatHolds        SeatHold[]
  booking          MovieBooking?
  payments         Payment[]
  refunds          Refund[]
  voucherUsage     VoucherUsage?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([showtimeId])
  @@index([cinemaId])
  @@index([movieId])
  @@index([status])
  @@index([expiresAt])
}

model MovieOrderItem {
  id             String             @id @default(uuid())
  movieOrderId   String
  movieOrder     MovieOrder         @relation(fields: [movieOrderId], references: [id], onDelete: Cascade)
  itemType       MovieOrderItemType
  seatId         String?
  seat           Seat?              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  showtimeSeatId String?
  showtimeSeat   ShowtimeSeat?      @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)
  comboId        String?
  combo          Combo?             @relation(fields: [comboId], references: [id], onDelete: Restrict)
  nameSnapshot   String
  codeSnapshot   String?
  unitPrice      Decimal
  quantity       Int                @default(1)
  totalPrice     Decimal
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([movieOrderId])
  @@index([itemType])
  @@index([seatId])
  @@index([comboId])
}

model MovieBooking {
  id                String             @id @default(uuid())
  bookingCode       String             @unique
  movieOrderId      String             @unique
  movieOrder        MovieOrder         @relation(fields: [movieOrderId], references: [id], onDelete: Restrict)
  cinemaId          String
  cinema            Cinema             @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  showtimeId        String
  showtime          Showtime           @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  externalBookingId String?            @unique
  adapterBrand      CinemaBrand
  status            MovieBookingStatus @default(PENDING)
  failureReason     String?
  cancelReason      String?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  expiresAt         DateTime?
  rawAdapterPayload Json?
  tickets           MovieTicket[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([cinemaId])
  @@index([showtimeId])
  @@index([status])
  @@index([externalBookingId])
}

model MovieTicket {
  id                String            @id @default(uuid())
  ticketCode        String            @unique
  barcode           String            @unique
  bookingId         String
  booking           MovieBooking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  movieId           String
  movie             Movie             @relation(fields: [movieId], references: [id], onDelete: Restrict)
  cinemaId          String
  cinema            Cinema            @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  showtimeId        String
  showtime          Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  auditoriumName    String
  seatCodes         String
  combosSummary     String?
  ticketType        MovieTicketType   @default(PRINT_AT_COUNTER)
  status            MovieTicketStatus @default(ISSUED)
  issuedAt          DateTime          @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  counterPrintCount Int               @default(0)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([bookingId])
  @@index([movieId])
  @@index([cinemaId])
  @@index([showtimeId])
  @@index([status])
  @@index([barcode])
}
